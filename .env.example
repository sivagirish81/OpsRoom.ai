# Copy to .env. Never commit the populated .env file.
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000

# Any OpenAI-compatible chat completion endpoint can be used.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# W&B Weave. Set WANDB_API_KEY (required for cloud traces).
WANDB_API_KEY=
# Optional: override auto-detected W&B entity (team/username).
WANDB_ENTITY=
WEAVE_PROJECT=opsroom-ai
WEAVE_DISABLED=false

# Used by the frontend container/Next.js runtime.
OPSROOM_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_OPSROOM_API_URL=http://localhost:8000

